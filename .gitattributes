# 默认：由 git 自动判定文本/二进制，文本入库与检出统一用 LF
* text=auto eol=lf

# 文本文件显式声明（checkout 时保持 LF）
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf

# PowerShell 脚本在 Windows 上按 CRLF 落盘更稳妥
*.ps1   text eol=crlf

# 音频一律当二进制，禁止任何换行/编码转换
*.wav   binary
*.m4a   binary
*.mp3   binary
*.ogg   binary
*.oga   binary
*.flac  binary
*.aac   binary

# 语言统计：文档不计入代码量
*.md    linguist-documentation
